# Desenvolvimento local. Em produção use uma URL HTTPS real e NODE_ENV=production.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000
NODE_ENV=development
# Habilitar apenas para cloudflared no MESMO servidor, encaminhando por loopback.
TRUST_PROXY=false
RETENTION_DAYS=30
# Banco fora da pasta public. Conferir nome de variável na documentação do servidor.
DB_PATH=./data/freedom.sqlite
